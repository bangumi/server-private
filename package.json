{
  "name": "app",
  "version": "0.65.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "bin/main.ts",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^24.0"
  },
  "scripts": {
    "generate:pb": "rimraf vendor/proto && buf generate upstream/proto",
    "drizzle-pull": "drizzle-kit introspect",
    "format": "prettier --list-different -w ./",
    "tsc": "tsc",
    "lint": "eslint -c eslint.config.mjs ./",
    "build": "node build.mjs",
    "build-common": "node scripts/build-common.mjs",
    "start": "nodemon ./bin/main.ts",
    "start-cron": "nodemon ./bin/cron.ts",
    "start-mq": "nodemon ./bin/mq.ts",
    "pretest": "node scripts/reset-test-db.mjs",
    "test": "vitest --run",
    "vitest": "vitest",
    "file": "node --no-warnings --import tsx/esm",
    "e": "node --no-warnings -r dotenv/config --import tsx/esm",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@bgm38/wiki": "0.3.3",
    "@bufbuild/protobuf": "2.16.0",
    "@confluentinc/kafka-javascript": "1.11.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/error": "4.2.1",
    "@fastify/formbody": "9.0.1",
    "@fastify/request-context": "7.0.5",
    "@fastify/sse": "0.6.1",
    "@fastify/static": "10.1.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "@fastify/view": "12.0.1",
    "@node-rs/bcrypt": "2.0.0",
    "@prometheus-io/client": "0.16.1",
    "@sentry/node": "10.76.2",
    "@simplewebauthn/server": "13.3.3",
    "@trim21/php-serialize": "0.2.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-keywords": "5.1.0",
    "altair-static": "8.5.11",
    "cron": "4.4.0",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-metrics": "14.1.1",
    "fastify-plugin": "6.0.1",
    "got": "16.1.0",
    "graphql": "17.0.2",
    "http-proxy-agent": "9.1.0",
    "http-status-codes": "2.3.0",
    "https-proxy-agent": "9.1.0",
    "ioredis": "6.0.0",
    "js-yaml": "5.5.0",
    "keyv": "5.6.0",
    "liquidjs": "10.30.0",
    "lodash-es": "4.18.1",
    "luxon": "3.7.2",
    "meilisearch": "0.62.0",
    "memjs": "1.3.2",
    "mercurius": "16.12.1",
    "micromatch": "4.0.8",
    "mime-types": "3.0.2",
    "mysql2": "3.24.6",
    "openapi-types": "12.1.3",
    "parse-duration": "2.1.10",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.4",
    "socks-proxy-agent": "10.1.0",
    "typebox": "1.4.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-resolvers": "6.1.0",
    "@shopify/prettier-plugin-liquid": "1.11.1",
    "@types/ioredis-mock": "8.2.8",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "4.17.12",
    "@types/luxon": "3.7.6",
    "@types/memjs": "1.3.3",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.19.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@typescript-eslint/utils": "8.71.0",
    "@vitest/coverage-v8": "5.0.2",
    "cheerio": "1.2.0",
    "dotenv": "18.0.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "esbuild-node-externals": "2.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-erasable-syntax-only": "0.7.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.3",
    "eslint-plugin-unicorn": "79.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "graphql-tag": "2.12.7",
    "husky": "9.1.7",
    "ioredis-mock": "8.13.1",
    "lint-staged": "17.6.0",
    "mercurius-integration-testing": "9.0.1",
    "nodemon": "3.1.14",
    "p-limit": "7.3.3",
    "prettier": "3.9.9",
    "prettier-plugin-jsdoc": "1.8.1",
    "rimraf": "6.1.3",
    "std-env": "4.3.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vitest": "5.0.2"
  },
  "nodemonConfig": {
    "ignore": [
      "**.test.ts"
    ],
    "watch": [
      "bin",
      "lib",
      "routes",
      "config.yaml",
      "package.json",
      "tsconfig.json",
      ".env"
    ],
    "delay": 100,
    "execMap": {
      "ts": "node --no-warnings -r dotenv/config --import tsx/esm"
    },
    "env": {
      "NODE_ENV": "development",
      "REF": "development"
    },
    "ext": "ts,js,json,html"
  },
  "author": "",
  "prettier": {
    "plugins": [
      "@shopify/prettier-plugin-liquid",
      "prettier-plugin-jsdoc"
    ],
    "tsdoc": true,
    "printWidth": 100,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all"
  }
}
